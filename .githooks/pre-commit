#!/bin/sh
# Zapnout: git config core.hooksPath .githooks
# Zkontroluje soubory připravené ke commitu. S lokálními daty porovná i se skutečnými jmény.
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0
for f in $files; do
  case "$f" in data/*|app/data/*|v2/data/*|v2/outbox/*) echo "BLOCKED: $f patří mezi osobní data, nesmí do gitu."; exit 1;; esac
done
python3 -I tools/check_public.py $files
